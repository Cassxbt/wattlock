{
  "buildCommand": "mkdir -p .vercel-out && cp index.html site.css site.js .nojekyll .vercel-out/ && cp -R assets demo faq how-it-works proof verify .vercel-out/",
  "outputDirectory": ".vercel-out",
  "installCommand": "",
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/api/cc3/:path*",
      "destination": "https://creditcoin-testnet.blockscout.com/api/v2/:path*"
    },
    {
      "source": "/api/sepolia/:path*",
      "destination": "https://eth-sepolia.blockscout.com/api/v2/:path*"
    }
  ]
}
